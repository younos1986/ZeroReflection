{
  "profiles": {
    "Swagger UI": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "http://localhost:5100/swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "http://localhost:5100"
    },
    "Mock Lambda Test Tool": {
      "commandName": "Executable",
      "commandLineArgs": "--port 5050",
      "workingDirectory": ".\\bin\\Debug\\net8.0",
      "executablePath": "%USERPROFILE%\\.dotnet\\tools\\dotnet-lambda-test-tool-8.0.exe",
      "environmentVariables": {
        "LAMBDA_NET_SERIALIZER_DEBUG": "true",
        "ASPNETCORE_ENVIRONMENT": "dev"
      }
    },
    "Mock Lambda Test Tool Rider": {
      "commandName": "Executable",
      "commandLineArgs": "%USERPROFILE%/.dotnet/tools/.store/amazon.lambda.testtool-8.0/0.15.2/amazon.lambda.testtool-8.0/0.15.2/tools/net8.0/any/Amazon.Lambda.TestTool.BlazorTester.dll",
      "workingDirectory": "$(ProjectDir)",
      "executablePath": "dotnet",
      "environmentVariables": {
        "LAMBDA_NET_SERIALIZER_DEBUG": "true",
        "ASPNETCORE_ENVIRONMENT": "prod"
      }
    },
    "Both (Swagger + Lambda)": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "http://localhost:5100/swagger",
      "environmentVariables": {
        "RUN_BOTH_SERVERS": "true",
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}